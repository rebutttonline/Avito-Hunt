# Telegram
TELEGRAM_BOT_TOKEN=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (generate a unique password for production)
POSTGRES_DB=avito_hunt
POSTGRES_USER=avito_hunt
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Authorized JSON feed. Leave empty until a data source is connected.
SOURCE_JSON_URL=
SOURCE_POLL_SECONDS=60

# Optional 14-day, low-frequency public HTML pilot. Never combine with bypass tools.
AVITO_SCRAPER_ENABLED=false
AVITO_SCRAPER_TARGETS=
AVITO_SCRAPER_MIN_INTERVAL_SECONDS=600
AVITO_SCRAPER_MAX_LISTING_AGE_MINUTES=90
AVITO_SCRAPER_EXPIRES_AT=

# Deal detection
DEAL_DISCOUNT_PERCENT=15
MIN_COMPARABLE_LISTINGS=10
COMPARABLE_MAX_AGE_DAYS=30
