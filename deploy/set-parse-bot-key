#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/opt/avito-hunt"
readonly ENV_FILE="/etc/avito-hunt/avito-hunt.env"
readonly AUTH_CHECK_URL="https://api.parse.bot/dispatch/tasks?limit=1"

test -f "$ENV_FILE" || { echo "Missing $ENV_FILE" >&2; exit 1; }

read -rsp "Paste the rotated Parse.bot API key: " parse_bot_key
echo
if [[ ! "$parse_bot_key" =~ ^[A-Za-z0-9_-]{20,}$ ]]; then
    echo "The key format looks invalid; nothing was changed." >&2
    exit 1
fi

response_file="$(mktemp)"
env_file="$(mktemp)"
trap 'rm -f "$response_file" "$env_file"' EXIT

status_code="$(curl --silent --show-error --output "$response_file" --write-out '%{http_code}' \
    --retry 2 --retry-delay 1 --retry-all-errors \
    --get "$AUTH_CHECK_URL" \
    --header "X-API-Key: $parse_bot_key")"
if [[ "$status_code" != "200" ]]; then
    echo "Parse.bot rejected the key or its authentication service returned an error (HTTP $status_code)." >&2
    echo "Nothing was changed." >&2
    exit 1
fi

awk -F= '$1 != "PARSE_BOT_API_KEY" && $1 !~ /^PARSE_BOT_/' "$ENV_FILE" > "$env_file"
{
    printf 'PARSE_BOT_API_KEY=%s\n' "$parse_bot_key"
    printf 'PARSE_BOT_QUERY=iphone\n'
    printf 'PARSE_BOT_CATEGORY=telefony\n'
    printf 'PARSE_BOT_LOCATION=novokuznetsk\n'
    printf 'PARSE_BOT_PRICE_MIN=1000\n'
    printf 'PARSE_BOT_PRICE_MAX=100000\n'
    printf 'PARSE_BOT_MAX_PAGES=1\n'
    printf 'PARSE_BOT_SNAPSHOT_VERSION=129\n'
    printf 'PARSE_BOT_MIN_INTERVAL_SECONDS=300\n'
} >> "$env_file"
install -m 600 -o root -g root "$env_file" "$ENV_FILE"

compose=(docker compose --env-file "$ENV_FILE" --project-directory "$APP_DIR" -f "$APP_DIR/compose.yaml")
"${compose[@]}" config --quiet
"${compose[@]}" up -d --no-deps --force-recreate worker

echo "Parse.bot is connected. The worker will poll one page every five minutes."
